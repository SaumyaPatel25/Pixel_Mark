# Hardened Playwright ARM64 Container for OCI Ampere A1.Flex
FROM mcr.microsoft.com/playwright/python:v1.60.0-noble

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PORT=8765

WORKDIR /app

# Install system utilities and SSL root certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY . .

# Ensure cache directory exists with appropriate permissions
RUN mkdir -p /app/cache && chmod 777 /app/cache

EXPOSE 8765

# Launch Uvicorn with 2 workers matching the 2 OCPUs on OCI Always Free
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8765", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
