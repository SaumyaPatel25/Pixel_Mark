<mjml>
  <mj-head>
    <mj-title>🚨 STAGE Escalation: Critical Pin Unresolved for {{ hours_elapsed }}h</mj-title>
    <mj-preview>URGENT: SLA breached for {{ priority }} pin on {{ project_name }} ({{ hours_elapsed }}h open)</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#cbd5e1" line-height="1.6" />
    </mj-attributes>
    <mj-style inline="inline">
      .badge-danger {
        background-color: #7f1d1d;
        border: 1px solid #ef4444;
        color: #fecaca;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        display: inline-block;
      }
      .code-snippet {
        background-color: #030712;
        border: 1px solid #1f2937;
        border-radius: 6px;
        padding: 8px 12px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
        color: #f87171;
      }
      .metric-box {
        background-color: #1e1b4b;
        border: 1px solid #4338ca;
        border-radius: 8px;
        padding: 12px 16px;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#090d16">
    <mj-section padding="30px 10px 10px 10px">
      <mj-column width="100%">
        <!-- Warning Top Stripe -->
        <mj-table padding="0 0 10px 0">
          <tr>
            <td style="background:#dc2626;height:4px;border-radius:4px 4px 0 0;"></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Main Container -->
    <mj-section background-color="#0f172a" border="1px solid #991b1b" border-radius="12px" padding="32px 28px">
      <mj-column width="100%">
        
        <!-- Urgency Header Badge -->
        <mj-text padding="0 0 12px 0">
          <span class="badge-danger">🚨 SLA BREACH &middot; ESCALATION NOTICE</span>
        </mj-text>

        <!-- Main Headline -->
        <mj-text font-size="22px" font-weight="800" color="#ffffff" line-height="1.3" padding="0 0 8px 0">
          {{ priority }} Pin Unresolved for {{ hours_elapsed }}h
        </mj-text>
        <mj-text font-size="14px" color="#94a3b8" padding="0 0 20px 0">
          Workspace Project: <strong style="color: #f1f5f9;">{{ project_name }}</strong>
        </mj-text>

        <mj-divider border-width="1px" border-color="#334155" padding="0 0 20px 0" />

        <!-- Aggressive Alert Message -->
        <mj-text font-size="14px" color="#f87171" line-height="1.6" padding="0 0 20px 0">
          <strong>Action Required:</strong> A <span style="text-transform:uppercase;color:#ef4444;font-weight:700;">{{ priority }}</span> review pin has exceeded the guaranteed SLA resolution threshold of <strong>{{ sla_threshold_hours }}h</strong>. This incident has been automatically escalated to workspace owners and assignees.
        </mj-text>

        <!-- Breach Telemetry Grid -->
        <mj-table padding="0 0 20px 0">
          <tr style="border-bottom: 1px solid #1e293b;">
            <td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase; font-weight: 700; width: 35%;">Time in Open State</td>
            <td style="padding: 10px 0; font-size: 14px; color: #ef4444; font-weight: 700; font-family: monospace;">{{ hours_elapsed }} hours</td>
          </tr>
          <tr style="border-bottom: 1px solid #1e293b;">
            <td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase; font-weight: 700;">SLA Window Target</td>
            <td style="padding: 10px 0; font-size: 14px; color: #f59e0b; font-weight: 600; font-family: monospace;">&le; {{ sla_threshold_hours }} hours</td>
          </tr>
          <tr style="border-bottom: 1px solid #1e293b;">
            <td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase; font-weight: 700;">Reported By</td>
            <td style="padding: 10px 0; font-size: 13px; color: #e2e8f0;">{{ creator_name }} ({{ creator_role }})</td>
          </tr>
          <tr style="border-bottom: 1px solid #1e293b;">
            <td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase; font-weight: 700;">Target Page</td>
            <td style="padding: 10px 0; font-size: 13px; color: #38bdf8;">
              <a href="{{ page_url }}" style="color: #38bdf8; text-decoration: none;">{{ page_title }}</a>
            </td>
          </tr>
          <tr>
            <td style="padding: 10px 0; font-size: 12px; color: #64748b; text-transform: uppercase; font-weight: 700;">DOM Selector</td>
            <td style="padding: 10px 0;">
              <div class="code-snippet">{{ target_selector }}</div>
            </td>
          </tr>
        </mj-table>

        <!-- Pin Content Card -->
        <mj-text font-size="12px" color="#64748b" text-transform="uppercase" font-weight="700" padding="10px 0 6px 0">
          Pin Details &amp; Feedback
        </mj-text>
        <mj-table padding="0 0 24px 0">
          <tr>
            <td style="background-color: #1e293b; border-left: 4px solid #ef4444; border-radius: 0 8px 8px 0; padding: 14px 16px;">
              <div style="font-size: 14px; font-weight: 700; color: #ffffff; margin-bottom: 6px;">{{ pin_title }}</div>
              <div style="font-size: 13px; color: #e2e8f0; line-height: 1.5;">{{ pin_description }}</div>
            </td>
          </tr>
        </mj-table>

        <!-- CTA Button -->
        <mj-button background-color="#dc2626"
                   color="#ffffff"
                   font-size="14px"
                   font-weight="700"
                   border-radius="8px"
                   inner-padding="14px 32px"
                   padding="10px 0 20px 0"
                   align="center"
                   href="{{ review_url }}">
          Inspect &amp; Resolve Pin Now &rarr;
        </mj-button>

        <mj-text font-size="12px" color="#94a3b8" align="center" padding="0 0 10px 0">
          Or copy link: <a href="{{ review_url }}" style="color: #38bdf8; text-decoration: underline;">{{ review_url }}</a>
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="20px 0">
      <mj-column width="100%">
        <mj-text font-size="11px" color="#64748b" align="center" line-height="1.5">
          You received this automated escalation because you are a designated owner or assignee on STAGE.<br/>
          SLA rules: Critical &le; {{ sla_threshold_hours }}h &middot; High &le; 48h. Unresolved pins trigger automatic leadership visibility.
        </mj-text>
        <mj-text font-size="11px" color="#475569" align="center" padding="6px 0 0 0">
          &copy; STAGE &middot; All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
